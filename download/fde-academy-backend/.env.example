# FDE Academy backend — environment variables
# Copy to .env and fill in real values. NEVER commit a real .env.

# --- server ---
NODE_ENV=development                 # development | test | production
FDE_HOST=127.0.0.1                   # bind address (0.0.0.0 behind a load balancer)
FDE_PORT=8787

# --- database ---
# Production: PostgreSQL connection string. When set (and FDE_DB=auto) the
# standard `pg` driver is used — install it with: npm install pg
DATABASE_URL=postgresql://fde:fde_secret@localhost:5432/fde_academy
# Development/test fallback: embedded PostgreSQL (PGlite). Empty = in-memory
# (tests); set a directory for a persistent local database (e.g. ./pgdata).
FDE_DB=auto                          # auto | pg | pglite
FDE_PGLITE_DIR=

# --- secrets (REQUIRED in production; generate with: openssl rand -hex 48) ---
FDE_JWT_SECRET=change-me-48-hex-bytes-minimum-32

# --- token lifetimes ---
FDE_ACCESS_TOKEN_TTL_MIN=15          # short-lived JWT access tokens
FDE_REFRESH_TOKEN_TTL_DAYS=30        # rotating opaque refresh tokens
FDE_PASSWORD_RESET_TTL_MIN=60        # single-use recovery links
FDE_DOWNLOAD_TOKEN_TTL_MIN=10        # single-use book download links

# --- private file storage (book downloads). NEVER expose this directory. ---
FDE_STORAGE_DIR=storage

# --- optional AI tutor (grounded in the curriculum; see docs/AI_TUTOR.md) ---
FDE_AI_TUTOR=on                     # on | off (403 with a clear message when off)
FDE_AI_PROVIDER=auto                # auto | sdk | cli | stub

# --- logging ---
FDE_LOG_LEVEL=info                   # debug | info | warn | error

# --- CORS: origin that serves the frontend (empty = same-origin) ---
FDE_CORS_ORIGIN=

# --- dev/test only. These are HARD-OFF in production (config refuses to boot). ---
FDE_SEED_DEMO_USERS=0                # 1 = seed admin/author/student demo accounts
FDE_EXPOSE_RESET_TOKENS=0            # 1 = password-reset token in the response (tests)
FDE_DEMO_PASSWORD=ChangeMe-2026!     # password for demo accounts (non-production only)
